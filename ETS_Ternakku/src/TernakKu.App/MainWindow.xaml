<Window x:Class="TernakKu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:TernakKu.App.Controls"
        Title="TernakKu" Icon="Assets/TernakKu.ico" Width="1360" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="root">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Background="{DynamicResource TitlebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource PrimaryBrush}">
                        <c:Icon Kind="leaf" Size="12" Thickness="2.25" Foreground="{DynamicResource OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TernakKu" FontSize="12" FontWeight="SemiBold" Margin="8,0,10,0" VerticalAlignment="Center"/>
                    <Border CornerRadius="11" Height="22" Padding="8,0" VerticalAlignment="Center"
                            Visibility="{Binding ShowDbChip, Converter={StaticResource BoolToVisible}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTamu}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="{Binding DbChipIcon}" Size="12" Thickness="2" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DbChipText}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="btnMin" Click="Minimize_Click" ToolTip="Minimalkan" Style="{StaticResource WinButton}">
                        <Path Data="M0,5 H10" Stroke="{DynamicResource TextBrush}" StrokeThickness="1" Width="10" Height="10"/>
                    </Button>
                    <Button x:Name="btnMax" Click="Maximize_Click" ToolTip="Maksimalkan" Style="{StaticResource WinButton}">
                        <Path x:Name="maxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{DynamicResource TextBrush}" StrokeThickness="1" Width="10" Height="10"/>
                    </Button>
                    <Button x:Name="btnClose" Click="Close_Click" ToolTip="Tutup" Style="{StaticResource WinCloseButton}">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding Current}" Focusable="False"/>
    </Grid>
</Window>
