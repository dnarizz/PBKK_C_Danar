<UserControl x:Class="TernakKu.App.Views.Dialogs.GantiPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TernakKu.App.Controls">
    <StackPanel>
        <TextBlock Text="Password lama" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
        <PasswordBox Style="{StaticResource InputPassword}" PasswordChanged="Lama_Changed" c:Ui.Invalid="{Binding Galat.Ada[Lama]}"/>
        <TextBlock Text="{Binding Galat[Lama]}" Style="{StaticResource T.Error}" Margin="0,4,0,0" Visibility="{Binding Galat[Lama], Converter={StaticResource EmptyToCollapsed}}"/>

        <TextBlock Text="Password baru" Style="{StaticResource T.Label}" Margin="0,16,0,6"/>
        <PasswordBox Style="{StaticResource InputPassword}" PasswordChanged="Baru_Changed" c:Ui.Invalid="{Binding Galat.Ada[Baru]}"/>
        <TextBlock Text="{Binding Galat[Baru]}" Style="{StaticResource T.Error}" Margin="0,4,0,0" Visibility="{Binding Galat[Baru], Converter={StaticResource EmptyToCollapsed}}"/>
        <TextBlock Text="Minimal 6 karakter" Style="{StaticResource T.Hint}" Margin="0,4,0,0" Visibility="{Binding Galat[Baru], Converter={StaticResource EmptyToVisible}}"/>

        <TextBlock Text="Ulangi password baru" Style="{StaticResource T.Label}" Margin="0,16,0,6"/>
        <PasswordBox Style="{StaticResource InputPassword}" PasswordChanged="Ulangi_Changed" c:Ui.Invalid="{Binding Galat.Ada[Ulangi]}"/>
        <TextBlock Text="{Binding Galat[Ulangi]}" Style="{StaticResource T.Error}" Margin="0,4,0,0" Visibility="{Binding Galat[Ulangi], Converter={StaticResource EmptyToCollapsed}}"/>
    </StackPanel>
</UserControl>
