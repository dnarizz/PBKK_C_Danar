<UserControl x:Class="TernakKu.App.Views.Dialogs.PakanMasukView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TernakKu.App.Controls">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
                <TextBlock Text="Pakan" Style="{StaticResource T.Label}"/>
                <ComboBox ItemsSource="{Binding DaftarPakan}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding IdPakan}" AutomationProperties.Name="Pakan"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="{Binding LabelJumlah}" Style="{StaticResource T.Label}"/>
                <TextBox Text="{Binding Jumlah, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="0" c:Ui.Invalid="{Binding ErrJumlah.Ada}" AutomationProperties.Name="Jumlah"/>
                <TextBlock Text="{Binding ErrJumlah.Teks}" Style="{StaticResource T.Error}" Visibility="{Binding ErrJumlah.Teks, Converter={StaticResource EmptyToCollapsed}}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                <TextBlock Text="Total harga (Rp)" Style="{StaticResource T.Label}"/>
                <TextBox Text="{Binding Total, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="{Binding PlaceholderTotal}" c:Ui.Invalid="{Binding ErrTotal.Ada}" AutomationProperties.Name="Total harga"/>
                <TextBlock Text="{Binding ErrTotal.Teks}" Style="{StaticResource T.Error}" Visibility="{Binding ErrTotal.Teks, Converter={StaticResource EmptyToCollapsed}}"/>
                <TextBlock Text="{Binding HintTotal}" Style="{StaticResource T.Hint}"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Pemasok" Style="{StaticResource T.Label}"/>
                <TextBox Text="{Binding Pemasok, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="mis. UD Tani Makmur" AutomationProperties.Name="Pemasok"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="Tanggal" Style="{StaticResource T.Label}"/>
                <DatePicker SelectedDate="{Binding Tanggal}" DisplayDateEnd="{Binding BatasTanggal, Mode=OneWay}" AutomationProperties.Name="Tanggal"/>
                <TextBlock Text="{Binding ErrTanggal.Teks}" Style="{StaticResource T.Error}" Visibility="{Binding ErrTanggal.Teks, Converter={StaticResource EmptyToCollapsed}}"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="Stok bertambah dan pengeluaran otomatis tercatat di Keuangan." Style="{StaticResource T.Muted}" Margin="0,14,0,0"/>
    </StackPanel>
</UserControl>
