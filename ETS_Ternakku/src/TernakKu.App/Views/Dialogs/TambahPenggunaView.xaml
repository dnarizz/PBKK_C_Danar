<UserControl x:Class="TernakKu.App.Views.Dialogs.TambahPenggunaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TernakKu.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Nama lengkap" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" c:Ui.Invalid="{Binding Galat.Ada[Nama]}"/>
            <TextBlock Text="{Binding Galat[Nama]}" Style="{StaticResource T.Error}" Margin="0,4,0,0" Visibility="{Binding Galat[Nama], Converter={StaticResource EmptyToCollapsed}}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
            <TextBlock Text="Username" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" c:Ui.Invalid="{Binding Galat.Ada[Username]}"/>
            <TextBlock Text="{Binding Galat[Username]}" Style="{StaticResource T.Error}" Margin="0,4,0,0" Visibility="{Binding Galat[Username], Converter={StaticResource EmptyToCollapsed}}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Peran" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding DaftarPeran}" DisplayMemberPath="Label" SelectedValuePath="Nilai" SelectedValue="{Binding Peran}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,16,0,0" Grid.ColumnSpan="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Password" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
                    <PasswordBox Style="{StaticResource InputPassword}" PasswordChanged="Password_Changed" c:Ui.Invalid="{Binding Galat.Ada[Password]}"/>
                    <TextBlock Text="{Binding Galat[Password]}" Style="{StaticResource T.Error}" Margin="0,4,0,0" Visibility="{Binding Galat[Password], Converter={StaticResource EmptyToCollapsed}}"/>
                    <TextBlock Text="Minimal 6 karakter" Style="{StaticResource T.Hint}" Margin="0,4,0,0" Visibility="{Binding Galat[Password], Converter={StaticResource EmptyToVisible}}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ulangi password" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
                    <PasswordBox Style="{StaticResource InputPassword}" PasswordChanged="Ulangi_Changed" c:Ui.Invalid="{Binding Galat.Ada[Ulangi]}"/>
                    <TextBlock Text="{Binding Galat[Ulangi]}" Style="{StaticResource T.Error}" Margin="0,4,0,0" Visibility="{Binding Galat[Ulangi], Converter={StaticResource EmptyToCollapsed}}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
