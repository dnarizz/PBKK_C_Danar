<UserControl x:Class="TernakKu.App.Views.Dialogs.TimbangView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TernakKu.App.Controls">
    <StackPanel>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Tanggal" Style="{StaticResource T.Label}"/>
            <DatePicker SelectedDate="{Binding Tanggal}" DisplayDateEnd="{Binding BatasTanggal, Mode=OneWay}"/>
        </StackPanel>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Berat" Style="{StaticResource T.Label}"/>
            <TextBox Text="{Binding Berat, UpdateSourceTrigger=PropertyChanged}" c:Ui.Suffix="kg" c:Ui.Invalid="{Binding BeratSalah}"/>
            <TextBlock Text="{Binding BeratError}" Style="{StaticResource T.Error}" Visibility="{Binding BeratError, Converter={StaticResource EmptyToCollapsed}}"/>
            <TextBlock Text="{Binding Petunjuk}" Style="{StaticResource T.Hint}" Visibility="{Binding Petunjuk, Converter={StaticResource EmptyToCollapsed}}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Lingkar dada (opsional)" Style="{StaticResource T.Label}"/>
            <TextBox Text="{Binding LingkarDada, UpdateSourceTrigger=PropertyChanged}" c:Ui.Suffix="cm"/>
        </StackPanel>
    </StackPanel>
</UserControl>
