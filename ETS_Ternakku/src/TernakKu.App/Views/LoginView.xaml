<UserControl x:Class="TernakKu.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TernakKu.App.Controls">
    <Grid>
        <!-- Soft green glow rising from the bottom. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,1.2" GradientOrigin="0.5,1.2" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#3878C45F" Offset="0"/>
                    <GradientStop Color="#0078C45F" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="16,32" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="form" Grid.Column="1">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="formShift"/></StackPanel.RenderTransform>

                    <!-- Barn scene -->
                    <Viewbox Width="220" Margin="0,0,0,12">
                        <Canvas Width="240" Height="140">
                            <Ellipse Canvas.Left="185" Canvas.Top="19" Width="26" Height="26" Fill="{DynamicResource LeafBrush}" Opacity="0.55"/>
                            <Ellipse Canvas.Left="25" Canvas.Top="63" Width="30" Height="30" Fill="{DynamicResource LeafBrush}" Opacity="0.55"/>
                            <Rectangle Canvas.Left="82" Canvas.Top="60" Width="76" Height="58" RadiusX="2" RadiusY="2" Fill="{DynamicResource PrimarySoftBrush}"/>
                            <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M0 120c40 -14 80 -14 120 -6s80 10 120 -4 M74 64L120 30l46 34 M84 60h72a2 2 0 0 1 2 2v56h-76v-56a2 2 0 0 1 2 -2Z M112 46h16v12h-16Z M104 86h32v32h-32Z M104 86l32 32 M136 86l-32 32 M180 98v20 M196 98v20 M212 98v20 M228 98v18 M174 104h60 M174 112h60 M40 84v34"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="TernakKu" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <Border CornerRadius="6" Background="{DynamicResource DangerSoftBrush}" Padding="12,10" Margin="0,0,0,14"
                            Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="alert" Size="16" Thickness="2" Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Username + credentials button -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtUser" Height="44" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 c:Ui.Icon="user" c:Ui.Placeholder="Username" AutomationProperties.Name="Username"/>
                        <ToggleButton Grid.Column="1" Width="44" Height="44" Margin="8,0,0,0" Padding="0"
                                      IsChecked="{Binding TampilAkun}" Style="{StaticResource CredsToggle}"
                                      ToolTip="Lihat akun demo tiap peran" AutomationProperties.Name="Lihat akun demo">
                            <c:Icon Kind="key" Size="18"/>
                        </ToggleButton>
                    </Grid>

                    <!-- Password with show/hide -->
                    <Grid Margin="0,0,0,14">
                        <PasswordBox x:Name="pwd" Height="44" Style="{StaticResource InputPassword}" c:Ui.Icon="lock" c:Ui.Placeholder="Password" AutomationProperties.Name="Password"/>
                        <TextBox x:Name="pwdPlain" Height="44" Visibility="Collapsed" c:Ui.Icon="lock" Padding="0,0,36,0" AutomationProperties.Name="Password"/>
                        <Button x:Name="btnEye" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource Btn.IconGhost}" Width="32" Height="32"
                                Click="Eye_Click" ToolTip="Tampilkan password">
                            <c:Icon x:Name="eyeIcon" Kind="eye" Size="18"/>
                        </Button>
                    </Grid>

                    <CheckBox Content="Ingat saya" IsChecked="{Binding IngatSaya}" Margin="0,0,0,18"/>

                    <Button Content="Masuk" Height="44" IsDefault="True" Click="Masuk_Click" Style="{StaticResource Btn.Primary}" IsEnabled="{Binding Sibuk, Converter={StaticResource Not}}"/>

                    <Grid Margin="0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Height="1" Background="{DynamicResource BorderStrongBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="atau" Style="{StaticResource T.Small}" Margin="12,0"/>
                        <Border Grid.Column="2" Height="1" Background="{DynamicResource BorderStrongBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <Button Height="44" Command="{Binding TamuCommand}" Style="{StaticResource Btn.Secondary}" ToolTip="Memakai database tamu yang terpisah dari data akun">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="guest" Size="18"/>
                            <TextBlock Text="Masuk sebagai tamu" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding Versi}" Style="{StaticResource T.Small}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                </StackPanel>

                <!-- Credentials panel: stays open beside the form while typing. -->
                <Border Grid.Column="2" Width="300" Margin="24,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Style="{StaticResource Card}" Padding="18" Effect="{StaticResource Shadow.Soft}"
                        Visibility="{Binding TampilAkun, Converter={StaticResource BoolToVisible}}" IsVisibleChanged="Creds_IsVisibleChanged">
                    <Border.RenderTransform><TranslateTransform x:Name="credsShift"/></Border.RenderTransform>
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource IcoBox}" Width="30" Height="30">
                                    <c:Icon Kind="key" Size="16" Thickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Akun demo" Style="{StaticResource T.H2}" FontSize="15"/>
                                    <TextBlock Style="{StaticResource T.Small}">
                                        <Run Text="Database akun ·"/>
                                        <Run Text="{Binding FileAkun, Mode=OneWay}" FontFamily="Consolas"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding ToggleAkunCommand}" Style="{StaticResource Btn.IconGhost}" Width="30" Height="30" ToolTip="Tutup">
                                <c:Icon Kind="x" Size="16"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="Klik baris untuk mengisi form." Style="{StaticResource T.Small}" Margin="0,12,0,8"/>

                        <ItemsControl ItemsSource="{Binding Akun}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Btn.Plain}" Margin="0,0,0,6" Cursor="Hand"
                                            Command="{Binding DataContext.PakaiAkunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            ToolTip="Isi username dan password">
                                        <Border x:Name="row" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSunkenBrush}" Padding="12,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Peran}" Style="{StaticResource T.Small}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Username}" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text=" / " Foreground="{DynamicResource Text2Brush}" FontFamily="Consolas" FontSize="14"/>
                                                        <TextBlock Text="{Binding Password}" FontFamily="Consolas" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <c:Icon Grid.Column="1" Kind="arrowR" Size="16" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border CornerRadius="8" Background="{DynamicResource WarnSoftBrush}" Padding="12,10" Margin="0,6,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="guest" Size="14" Thickness="2" Foreground="{DynamicResource WarnBrush}"/>
                                    <TextBlock Text="Tamu" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource WarnBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource T.Small}" TextWrapping="Wrap" Margin="0,4,0,0">
                                    <Run Text="Tanpa akun. Pakai tombol Masuk sebagai tamu, datanya di"/>
                                    <Run Text="{Binding FileTamu, Mode=OneWay}" FontFamily="Consolas"/><Run Text="."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Password di atas adalah password awal. Jika diganti di aplikasi, yang lama tidak berlaku." Style="{StaticResource T.Hint}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
