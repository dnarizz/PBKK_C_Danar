<UserControl x:Class="TernakKu.App.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TernakKu.App.Controls"
             xmlns:p="clr-namespace:TernakKu.App.ViewModels.Pages"
             x:Name="page">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource LeafBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TileTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SpeciesBtn" TargetType="Button" BasedOn="{StaticResource Btn.Plain}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToneCircle" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="danger">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pen plot on the site plan: width by capacity, fill by occupancy -->
        <Style x:Key="PlotContainer" TargetType="ContentPresenter">
            <Setter Property="c:ProportionalPanel.Weight" Value="{Binding Kapasitas}"/>
        </Style>
        <DataTemplate x:Key="PlotTemplate">
            <Button Style="{StaticResource Btn.Plain}" ToolTip="{Binding Tip}" Height="74"
                    Command="{Binding DataContext.BukaKandangCommand, ElementName=page}" CommandParameter="{Binding Id}">
                <Border x:Name="plot" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True">
                    <Grid>
                        <Border x:Name="fill" VerticalAlignment="Bottom" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="0,0,5,5"
                                Height="{Binding Persen, Converter={StaticResource PercentToLength}, ConverterParameter=72}"/>
                        <StackPanel VerticalAlignment="Bottom" Margin="8">
                            <TextBlock Text="{Binding Kode}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Teks}" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                        </StackPanel>
                        <Border x:Name="alert" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" MinWidth="18" Height="18" CornerRadius="9" Padding="5,0"
                                Background="{DynamicResource DangerBrush}" Visibility="{Binding Sakit, Converter={StaticResource EmptyToCollapsed}}">
                            <TextBlock Text="{Binding Sakit}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter TargetName="fill" Property="Background" Value="{DynamicResource WarnSoftBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="danger"><Setter TargetName="fill" Property="Background" Value="{DynamicResource DangerSoftBrush}"/></DataTrigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="plot" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Timeline items -->
        <DataTemplate DataType="{x:Type p:TugasItem}">
            <Grid Width="168" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Jam}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource HeroMutedBrush}" Typography.NumeralAlignment="Tabular"/>
                <Border Grid.Row="1" Height="2" Margin="22,0,-12,0" VerticalAlignment="Center" Background="{DynamicResource HeroLineBrush}"/>
                <Button x:Name="dot" Grid.Row="1" Width="22" Height="22" Margin="0,6" HorizontalAlignment="Left" Cursor="Hand" FocusVisualStyle="{x:Null}"
                        Command="{Binding DataContext.JalankanCommand, ElementName=page}" CommandParameter="{Binding AksiTandai}"
                        IsHitTestVisible="{Binding BisaDitandai}" ToolTip="Tandai selesai" ToolTipService.IsEnabled="{Binding BisaDitandai}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="11" BorderThickness="2" BorderBrush="{DynamicResource LeafBrush}" Background="{DynamicResource HeroBgBrush}">
                                <c:Icon x:Name="tick" Kind="check" Size="14" Thickness="3" Foreground="{DynamicResource LeafInkBrush}" Visibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#5978C45F"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding Selesai}" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource LeafBrush}"/>
                                    <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Terlambat}" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource WarnBarBrush}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border x:Name="card" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,10" BorderThickness="1" BorderBrush="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="{Binding Ikon}" Size="14" Thickness="2" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock x:Name="title" Text="{Binding Judul}" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Sub}" Style="{StaticResource T.Small}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Padding="0" Margin="0,4,0,0" FontSize="12"
                                Visibility="{Binding AdaTombol, Converter={StaticResource BoolToVisible}}"
                                Command="{Binding DataContext.JalankanCommand, ElementName=page}" CommandParameter="{Binding AksiTombol}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tombol}"/>
                                <c:Icon Kind="chevR" Size="12" Thickness="2.25" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selesai}" Value="True">
                    <Setter TargetName="card" Property="Opacity" Value="0.72"/>
                    <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Terlambat}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource WarnBarBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type p:PenandaSekarang}">
            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border CornerRadius="9" Background="{DynamicResource WarnBarBrush}" Padding="7,1" ToolTip="Sekarang">
                    <TextBlock Text="{Binding Jam}" FontSize="11" FontWeight="Bold" Foreground="#1F2A17"/>
                </Border>
                <Border Grid.Row="1" Width="2" Margin="0,4,0,0" CornerRadius="1" Background="{DynamicResource WarnBarBrush}" HorizontalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- ===== Greeting band ===== -->
        <Border CornerRadius="12" Background="{DynamicResource HeroBgBrush}" ClipToBounds="True" Margin="0,0,0,20">
            <Grid>
                <Ellipse Width="300" Height="300" Fill="#2478C45F" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-110,-70,0" IsHitTestVisible="False"/>
                <Ellipse Width="220" Height="220" Stroke="{DynamicResource HeroLineBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,150,0" IsHitTestVisible="False"/>
                <StackPanel Margin="24,24,24,20">
                    <Grid>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Tanggal}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource HeroMutedBrush}"/>
                            <TextBlock Text="{Binding Sapaan}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource HeroTextBrush}" Margin="0,2,0,4"/>
                            <TextBlock Text="{Binding RingkasHariIni}" FontSize="14" Foreground="{DynamicResource HeroMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBox x:Name="cari" Width="300" c:Ui.Icon="search" c:Ui.Placeholder="Cari kode, nama, atau ras ternak" KeyDown="Cari_KeyDown" AutomationProperties.Name="Cari ternak"/>
                            <Button Margin="10,0,0,0" Command="{Binding TambahTernakCommand}" Style="{StaticResource Btn.Primary}"
                                    Visibility="{Binding BolehTambah, Converter={StaticResource BoolToVisible}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="plus" Size="16" Thickness="2.25"/>
                                    <TextBlock Text="Tambah ternak" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Style="{StaticResource Meter}" Height="4" Margin="0,18,0,14" Value="{Binding ProgresTugas, Mode=OneWay}"
                                 Background="{DynamicResource HeroLineBrush}" Foreground="{DynamicResource LeafBrush}"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                        <ItemsControl ItemsSource="{Binding Tugas}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,20"
                Visibility="{Binding IsTamu, Converter={StaticResource BoolToVisible}}">
            <DockPanel>
                <c:Icon Kind="info" Size="18" Margin="0,0,12,0"/>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="Anda memakai"/> <Run Text="database tamu" FontWeight="Bold"/> <Run Text="{Binding NamaFile, Mode=OneWay, StringFormat=({0}).}"/>
                    <Run Text="Data di sini tidak tercampur dengan data akun."/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ===== Row 1: population + reminders ===== -->
        <Grid Margin="0,0,-16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Border Style="{StaticResource IcoBox}" Width="30" Height="30"><c:Icon Kind="tag" Size="16" Thickness="2"/></Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BukaCommand}" CommandParameter="ternak">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Buka"/><c:Icon Kind="arrowR" Size="14" Thickness="2" Margin="4,0,0,0"/></StackPanel>
                        </Button>
                        <TextBlock Text="Populasi" Style="{StaticResource TileTitle}"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="132" Height="132" VerticalAlignment="Center">
                            <c:DonutChart Values="{Binding JumlahSpesies}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalAktif, StringFormat=N0}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="ekor aktif" Style="{StaticResource T.Small}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource SpeciesBtn}" Command="{Binding SpesiesCommand}" CommandParameter="1" Tag="{Binding FilterPopulasi, Converter={StaticResource Eq}, ConverterParameter=1}">
                                <DockPanel><Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding JumlahSpesies[0]}" FontWeight="Bold"/><TextBlock Text="Sapi"/></DockPanel>
                            </Button>
                            <Button Style="{StaticResource SpeciesBtn}" Command="{Binding SpesiesCommand}" CommandParameter="2" Tag="{Binding FilterPopulasi, Converter={StaticResource Eq}, ConverterParameter=2}">
                                <DockPanel><Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{DynamicResource WarnBarBrush}" Margin="0,0,8,0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding JumlahSpesies[1]}" FontWeight="Bold"/><TextBlock Text="Kambing"/></DockPanel>
                            </Button>
                            <Button Style="{StaticResource SpeciesBtn}" Command="{Binding SpesiesCommand}" CommandParameter="3" Tag="{Binding FilterPopulasi, Converter={StaticResource Eq}, ConverterParameter=3}">
                                <DockPanel><Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{DynamicResource InfoBrush}" Margin="0,0,8,0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding JumlahSpesies[2]}" FontWeight="Bold"/><TextBlock Text="Domba"/></DockPanel>
                            </Button>
                            <Button Style="{StaticResource SpeciesBtn}" Command="{Binding SpesiesCommand}" CommandParameter="all" Tag="{Binding FilterPopulasi, Converter={StaticResource Eq}, ConverterParameter=all}">
                                <StackPanel>
                                    <DockPanel><Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{DynamicResource Text2Brush}" Margin="0,0,8,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BaruBulanIni, StringFormat=+{0}}" FontWeight="Bold"/><TextBlock Text="Semua"/></DockPanel>
                                    <TextBlock Text="masuk bulan ini" Style="{StaticResource T.Small}" FontSize="11" Margin="18,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <DockPanel Margin="0,0,0,4">
                                <c:Badge DockPanel.Dock="Right" Tone="ok" ShowDot="False" Text="{Binding Pertumbuhan}"/>
                                <TextBlock Text="{Binding JudulPopulasi}" Style="{StaticResource T.Small}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <c:BarChart Height="170" Values="{Binding Populasi}" Labels="{Binding LabelBulan}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Tile}" Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBorderBrush}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Border Style="{StaticResource IcoBox}" Width="30" Height="30" Background="{DynamicResource SurfaceBrush}" TextElement.Foreground="{DynamicResource WarnBrush}"><c:Icon Kind="bell" Size="16" Thickness="2"/></Border>
                        <Border DockPanel.Dock="Right" CornerRadius="11" Background="{DynamicResource SurfaceBrush}" Padding="10,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding JumlahPengingat}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource WarnBrush}"/>
                        </Border>
                        <TextBlock Text="Perlu perhatian" Style="{StaticResource TileTitle}"/>
                    </DockPanel>
                    <TextBlock Text="Semua beres. Tidak ada pengingat hari ini." Style="{StaticResource T.Muted}" Visibility="{Binding Pengingat, Converter={StaticResource EmptyToVisible}}"/>
                    <ItemsControl ItemsSource="{Binding Pengingat}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Border Style="{StaticResource ToneCircle}"><c:Icon Kind="{Binding Ikon}" Size="16" Thickness="2"/></Border>
                                        <Button DockPanel.Dock="Right" Content="{Binding Tombol}" Style="{StaticResource Btn.SecondarySm}" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"
                                                Visibility="{Binding AdaTombol, Converter={StaticResource BoolToVisible}}"
                                                Command="{Binding DataContext.JalankanCommand, ElementName=page}" CommandParameter="{Binding Aksi}"/>
                                        <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Judul}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource T.Small}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Row 2: pens, feed, births ===== -->
        <Grid Margin="0,0,-16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding KolomPen, Converter={StaticResource Star}}"/>
                <ColumnDefinition Width="{Binding KolomPakan, Converter={StaticResource Star}}"/>
                <ColumnDefinition Width="{Binding KolomLahir, Converter={StaticResource Star}}"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Border Style="{StaticResource IcoBox}" Width="30" Height="30"><c:Icon Kind="home" Size="16" Thickness="2"/></Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BukaCommand}" CommandParameter="kandang">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Buka"/><c:Icon Kind="arrowR" Size="14" Thickness="2" Margin="4,0,0,0"/></StackPanel>
                        </Button>
                        <TextBlock Text="Denah kandang" Style="{StaticResource TileTitle}"/>
                    </DockPanel>
                    <Grid>
                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5" StrokeDashArray="4 3" Fill="{DynamicResource SurfaceSunkenBrush}"/>
                        <StackPanel Margin="10">
                            <ItemsControl ItemsSource="{Binding Petak}" ItemTemplate="{DynamicResource PlotTemplate}" ItemContainerStyle="{DynamicResource PlotContainer}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:ProportionalPanel Gap="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding PetakBaris2}" ItemTemplate="{DynamicResource PlotTemplate}" ItemContainerStyle="{DynamicResource PlotContainer}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:ProportionalPanel Gap="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button Grid.Column="1" Width="64" Height="74" Margin="8,0,0,0" Style="{StaticResource Btn.Plain}" Command="{Binding BukaCommand}" CommandParameter="pakan"
                                        IsEnabled="{Binding AdaPakan}" ToolTip="Gudang pakan">
                                    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}">
                                        <StackPanel VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Text2Brush}">
                                            <c:Icon Kind="box" Size="18"/>
                                            <TextBlock Text="Gudang" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Text2Brush}">
                        <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/><TextBlock Text="&lt; 80%" Margin="0,0,14,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{DynamicResource WarnBarBrush}" Margin="0,0,6,0"/><TextBlock Text="80–99%" Margin="0,0,14,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{DynamicResource DangerBrush}" Margin="0,0,6,0"/><TextBlock Text="penuh" Margin="0,0,14,0"/>
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource DangerBrush}" Margin="0,0,6,0"/><TextBlock Text="perlu perhatian"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Tile}" Visibility="{Binding AdaPakan, Converter={StaticResource BoolToVisible}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Border Style="{StaticResource IcoBox}" Width="30" Height="30"><c:Icon Kind="box" Size="16" Thickness="2"/></Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BukaCommand}" CommandParameter="pakan">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Buka"/><c:Icon Kind="arrowR" Size="14" Thickness="2" Margin="4,0,0,0"/></StackPanel>
                        </Button>
                        <TextBlock Text="Stok pakan" Style="{StaticResource TileTitle}"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <c:Badge Text="{Binding PakanRendah, StringFormat={}{0} di bawah minimum}" Tone="warn"/>
                        <TextBlock Text="garis putus = minimum" Style="{StaticResource T.Small}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Silo}" VerticalAlignment="Bottom">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Plain}" ToolTip="{Binding Tip}" Command="{Binding DataContext.BukaCommand, ElementName=page}" CommandParameter="pakan">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border x:Name="tank" Width="34" Height="92" CornerRadius="14,14,6,6" BorderThickness="2" BorderBrush="{DynamicResource BorderStrongBrush}"
                                                Background="{DynamicResource SurfaceSunkenBrush}" ClipToBounds="True">
                                            <Grid>
                                                <Border x:Name="fill" VerticalAlignment="Bottom" Background="{DynamicResource LeafBrush}" CornerRadius="0,0,4,4"
                                                        Height="{Binding Persen, Converter={StaticResource PercentToLength}, ConverterParameter=88}"/>
                                                <Line X1="0" X2="30" VerticalAlignment="Bottom" Margin="0,0,0,29" Stroke="{DynamicResource TextBrush}" Opacity="0.45" StrokeThickness="1.5" StrokeDashArray="2 2"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Nama}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="64"/>
                                        <TextBlock Text="{Binding Stok}" Style="{StaticResource T.Small}" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Rendah}" Value="True">
                                        <Setter TargetName="fill" Property="Background" Value="{DynamicResource WarnBarBrush}"/>
                                        <Setter TargetName="tank" Property="BorderBrush" Value="{DynamicResource WarnBarBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Tile}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Border Style="{StaticResource IcoBox}" Width="30" Height="30"><c:Icon Kind="repro" Size="16" Thickness="2"/></Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BukaCommand}" CommandParameter="reproduksi"
                                Visibility="{Binding DataContext.AdaReproduksi, ElementName=page, Converter={StaticResource BoolToVisible}, FallbackValue=Visible}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Buka"/><c:Icon Kind="arrowR" Size="14" Thickness="2" Margin="4,0,0,0"/></StackPanel>
                        </Button>
                        <TextBlock Text="Segera lahir" Style="{StaticResource TileTitle}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Lahir}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Plain}" Margin="0,0,0,6" Command="{Binding DataContext.BukaTernakCommand, ElementName=page}" CommandParameter="{Binding TernakId}">
                                    <Border x:Name="row" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" Padding="7">
                                        <DockPanel>
                                            <Border x:Name="count" Width="50" Height="34" CornerRadius="6" Background="{DynamicResource SurfaceSunkenBrush}">
                                                <TextBlock x:Name="countText" Text="{Binding Hitung}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kode}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource T.Small}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Dekat}" Value="True">
                                        <Setter TargetName="count" Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                                        <Setter TargetName="countText" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding JumlahBunting, StringFormat={}{0} induk bunting}" Style="{StaticResource T.Small}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Row 3: health, money, weighings ===== -->
        <Grid Margin="0,0,-16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding KolomSehat, Converter={StaticResource Star}}"/>
                <ColumnDefinition Width="{Binding KolomUang, Converter={StaticResource Star}}"/>
                <ColumnDefinition Width="{Binding KolomTimbang, Converter={StaticResource Star}}"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Tile}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Border Style="{StaticResource IcoBox}" Width="30" Height="30"><c:Icon Kind="heart" Size="16" Thickness="2"/></Border>
                        <TextBlock Text="Kesehatan" Style="{StaticResource TileTitle}"/>
                    </DockPanel>
                    <Path DockPanel.Dock="Top" Height="40" Stretch="Fill" Stroke="{DynamicResource DangerBrush}" StrokeThickness="2" Opacity="0.45" StrokeLineJoin="Round"
                          Data="M0 22h70l8 -12l10 24l10 -30l10 26l7 -8h125"/>
                    <UniformGrid Columns="3" VerticalAlignment="Bottom" Margin="0,16,0,0">
                        <StackPanel><TextBlock Text="{Binding Diobati}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/><TextBlock Text="diobati" Style="{StaticResource T.Small}"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding Periksa}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"/><TextBlock Text="perlu periksa" Style="{StaticResource T.Small}"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding Vaksin7}" FontSize="22" FontWeight="Bold"/><TextBlock Text="vaksin 7 hari" Style="{StaticResource T.Small}"/></StackPanel>
                    </UniformGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Tile}" Visibility="{Binding AdaKeuangan, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border Style="{StaticResource IcoBox}" Width="30" Height="30"><c:Icon Kind="wallet" Size="16" Thickness="2"/></Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BukaCommand}" CommandParameter="keuangan">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Buka"/><c:Icon Kind="arrowR" Size="14" Thickness="2" Margin="4,0,0,0"/></StackPanel>
                        </Button>
                        <TextBlock Text="Laba bulan ini" Style="{StaticResource TileTitle}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Laba}" FontSize="28" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LabaPositif}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <c:Sparkline Height="56" Values="{Binding TrenLaba}" Margin="0,4"/>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <StackPanel><TextBlock Text="{Binding Masuk}" FontSize="16" FontWeight="Bold"/><TextBlock Text="masuk" Style="{StaticResource T.Small}"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding Keluar}" FontSize="16" FontWeight="Bold"/><TextBlock Text="keluar" Style="{StaticResource T.Small}"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Tile}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Border Style="{StaticResource IcoBox}" Width="30" Height="30"><c:Icon Kind="scale" Size="16" Thickness="2"/></Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding BukaCommand}" CommandParameter="ternak">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Buka"/><c:Icon Kind="arrowR" Size="14" Thickness="2" Margin="4,0,0,0"/></StackPanel>
                        </Button>
                        <TextBlock Text="Penimbangan terbaru" Style="{StaticResource TileTitle}"/>
                    </DockPanel>
                    <Grid Margin="0,0,0,2" TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Text2Brush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ternak" Margin="8,6"/>
                        <TextBlock Grid.Column="1" Text="Berat" HorizontalAlignment="Right" Margin="8,6"/>
                        <TextBlock Grid.Column="2" Text="ADG kg/hari" HorizontalAlignment="Right" Margin="8,6"/>
                        <TextBlock Grid.Column="3" Text="Tanggal" HorizontalAlignment="Right" Margin="8,6"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                    <ItemsControl ItemsSource="{Binding Timbang}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Plain}" Command="{Binding DataContext.BukaTernakCommand, ElementName=page}" CommandParameter="{Binding TernakId}">
                                    <Border x:Name="row" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Background="Transparent" Height="38">
                                        <Grid VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" TextElement.FontSize="13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Margin="8,0"><Run Text="{Binding Kode, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/> <Run Text="{Binding Ras, Mode=OneWay}" Foreground="{DynamicResource Text2Brush}"/></TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Berat}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="8,0"/>
                                            <TextBlock x:Name="adg" Grid.Column="2" Text="{Binding Adg}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="8,0" Foreground="{DynamicResource Text2Brush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Tanggal}" HorizontalAlignment="Right" Margin="8,0" Foreground="{DynamicResource Text2Brush}"/>
                                        </Grid>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Tone}" Value="ok"><Setter TargetName="adg" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="danger"><Setter TargetName="adg" Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/></Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
