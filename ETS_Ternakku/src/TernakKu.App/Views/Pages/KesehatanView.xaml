<UserControl x:Class="TernakKu.App.Views.Pages.KesehatanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TernakKu.App.Controls"
             x:Name="page">
    <UserControl.Resources>
        <Style x:Key="ToneBox" TargetType="Border" BasedOn="{StaticResource IcoBox}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="danger">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="info">
                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource InfoBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DayText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header -->
        <Grid Margin="0,0,0,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Kesehatan" Style="{StaticResource T.H1}"/>
                <TextBlock Text="Pemeriksaan, pengobatan, dan jadwal vaksin" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding BolehKesehatan, Converter={StaticResource BoolToVisible}}">
                <Button Style="{StaticResource Btn.Secondary}" Command="{Binding JadwalkanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="calendar" Size="16" Thickness="2"/>
                        <TextBlock Text="Jadwalkan vaksin" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Primary}" Command="{Binding TambahCommand}" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="plus" Size="16" Thickness="2.25"/>
                        <TextBlock Text="Catat pemeriksaan" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Stat cards -->
        <ItemsControl ItemsSource="{Binding Statistik}" Margin="0,0,-16,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,16,16">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource ToneBox}" VerticalAlignment="Top"><c:Icon Kind="{Binding Ikon}" Size="18" Thickness="2"/></Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Judul}" Style="{StaticResource T.Small}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                    <TextBlock Text="{Binding Nilai}" Style="{StaticResource T.Stat}"/>
                                    <TextBlock Text="{Binding Satuan}" Style="{StaticResource T.Muted}" Margin="6,0,0,5" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock x:Name="sub" Text="{Binding Sub}" Style="{StaticResource T.Small}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding SubBahaya}" Value="True">
                            <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            <Setter TargetName="sub" Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left: attention + history -->
            <StackPanel>
                <Border Style="{StaticResource CardFlush}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="20,18,20,8">
                            <c:Badge DockPanel.Dock="Right" Tone="neutral" ShowDot="False" Text="{Binding Perhatian.Count}"/>
                            <TextBlock Text="Perlu perhatian" Style="{StaticResource T.H2}"/>
                        </DockPanel>
                        <TextBlock Text="Semua ternak sehat" Style="{StaticResource T.Muted}" Margin="20,4,20,18" Visibility="{Binding Perhatian, Converter={StaticResource EmptyToVisible}}"/>
                        <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding Perhatian}" MaxHeight="360" Visibility="{Binding Perhatian, Converter={StaticResource EmptyToCollapsed}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Ternak" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Padding="0" FontWeight="SemiBold" Content="{Binding Label}"
                                                    Command="{Binding DataContext.BukaTernakCommand, ElementName=page}" CommandParameter="{Binding TernakId}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Kandang" Binding="{Binding Kandang}" Width="110" ElementStyle="{StaticResource Cell.Muted}"/>
                                <DataGridTemplateColumn Header="Kondisi" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <c:Badge Text="{Binding Kondisi}" Tone="{Binding Tone}" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Catatan terakhir" Binding="{Binding Catatan}" Width="*" MinWidth="140" ElementStyle="{StaticResource Cell.Muted}"/>
                                <DataGridTemplateColumn Width="176">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        Visibility="{Binding DataContext.BolehKesehatan, ElementName=page, Converter={StaticResource BoolToVisible}}">
                                                <Button Content="Periksa" Style="{StaticResource Btn.GhostSm}" Command="{Binding DataContext.PeriksaCommand, ElementName=page}" CommandParameter="{Binding TernakId}"/>
                                                <Button Content="Tandai sehat" Style="{StaticResource Btn.SecondarySm}" Margin="6,0,0,0" Command="{Binding DataContext.TandaiSehatCommand, ElementName=page}" CommandParameter="{Binding TernakId}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardFlush}">
                    <StackPanel>
                        <TextBlock Text="Riwayat pemeriksaan" Style="{StaticResource T.H2}" Margin="20,18,20,8"/>
                        <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding Riwayat}" MaxHeight="480">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal}" Width="80"/>
                                <DataGridTemplateColumn Header="Ternak" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Padding="0" FontWeight="SemiBold" Content="{Binding Kode}"
                                                    Command="{Binding DataContext.BukaTernakCommand, ElementName=page}" CommandParameter="{Binding TernakId}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Keluhan" Binding="{Binding Keluhan}" Width="*"/>
                                <DataGridTextColumn Header="Diagnosa" Binding="{Binding Diagnosa}" Width="*"/>
                                <DataGridTextColumn Header="Tindakan" Binding="{Binding Tindakan}" Width="1.5*" ElementStyle="{StaticResource Cell.Muted}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right: calendar + stock -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding BulanCommand}" CommandParameter="-1" ToolTip="Bulan sebelumnya" AutomationProperties.Name="Bulan sebelumnya">
                                    <c:Icon Kind="chevL" Size="16" Thickness="2"/>
                                </Button>
                                <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Margin="4,0,0,0" Command="{Binding BulanCommand}" CommandParameter="1" ToolTip="Bulan berikutnya" AutomationProperties.Name="Bulan berikutnya">
                                    <c:Icon Kind="chevR" Size="16" Thickness="2"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding JudulBulan}" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <UniformGrid Columns="7" Margin="0,0,0,4">
                            <TextBlock Text="Sen" Style="{StaticResource T.Caps}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sel" Style="{StaticResource T.Caps}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Rab" Style="{StaticResource T.Caps}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Kam" Style="{StaticResource T.Caps}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Jum" Style="{StaticResource T.Caps}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sab" Style="{StaticResource T.Caps}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Min" Style="{StaticResource T.Caps}" HorizontalAlignment="Center"/>
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding Hari}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Btn.Plain}" Height="42" Margin="1"
                                            Command="{Binding DataContext.PilihHariCommand, ElementName=page}" CommandParameter="{Binding Tanggal}">
                                        <Border x:Name="cell" CornerRadius="8" BorderThickness="1.5" BorderBrush="Transparent" Background="Transparent">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="num" Text="{Binding Angka}" Style="{StaticResource DayText}"/>
                                                <ItemsControl ItemsSource="{Binding Pip}" HorizontalAlignment="Center" Height="7" Margin="0,2,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Ellipse x:Name="dot" Width="5" Height="5" Margin="1,0" Fill="{DynamicResource WarnBarBrush}"/>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="ok"><Setter TargetName="dot" Property="Fill" Value="{DynamicResource PrimaryBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="danger"><Setter TargetName="dot" Property="Fill" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding LuarBulan}" Value="True"><Setter TargetName="num" Property="Opacity" Value="0.4"/></DataTrigger>
                                        <DataTrigger Binding="{Binding HariIni}" Value="True"><Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Dipilih}" Value="True">
                                            <Setter TargetName="cell" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter TargetName="num" Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                                            <Setter TargetName="num" Property="FontWeight" Value="Bold"/>
                                            <Setter TargetName="num" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,10,0,0" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Text2Brush}">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource WarnBarBrush}" Margin="0,0,6,0"/><TextBlock Text="terjadwal" Margin="0,0,14,0"/>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/><TextBlock Text="selesai" Margin="0,0,14,0"/>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" Margin="0,0,6,0"/><TextBlock Text="terlewat"/>
                        </WrapPanel>
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding JudulHari}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="Tidak ada jadwal" Style="{StaticResource T.Muted}" Margin="0,8,0,0" Visibility="{Binding JadwalHari, Converter={StaticResource EmptyToVisible}}"/>
                                <ItemsControl ItemsSource="{Binding JadwalHari}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,10,0,0">
                                                <Button DockPanel.Dock="Right" Content="Tandai selesai" Style="{StaticResource Btn.SecondarySm}" VerticalAlignment="Center"
                                                        Visibility="{Binding BisaSelesai, Converter={StaticResource BoolToVisible}}"
                                                        Command="{Binding DataContext.SelesaiCommand, ElementName=page}" CommandParameter="{Binding Ids}"/>
                                                <c:Badge DockPanel.Dock="Right" Text="{Binding Status}" Tone="{Binding Tone}" VerticalAlignment="Center"
                                                         Visibility="{Binding BisaSelesai, Converter={StaticResource BoolToCollapsed}}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Judul}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource T.Small}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Stok obat dan vaksin" Style="{StaticResource T.H2}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Obat}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel Margin="0,0,0,6" TextElement.FontSize="13">
                                            <TextBlock x:Name="stok" DockPanel.Dock="Right" Text="{Binding Stok}" Foreground="{DynamicResource Text2Brush}" Typography.NumeralAlignment="Tabular" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding Nama}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="meter" Style="{StaticResource Meter}" Value="{Binding Persen, Mode=OneWay}"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Rendah}" Value="True">
                                            <Setter TargetName="stok" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                            <Setter TargetName="stok" Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="meter" Property="Foreground" Value="{DynamicResource WarnBarBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
