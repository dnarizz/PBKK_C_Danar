<UserControl x:Class="TernakKu.App.Views.Pages.LaporanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TernakKu.App.Controls"
             xmlns:p="clr-namespace:TernakKu.App.ViewModels.Pages"
             xmlns:v="clr-namespace:TernakKu.App.Views.Pages">
    <UserControl.Resources>
        <v:PilihanKonverter x:Key="Pilih"/>

        <!-- Report type choice: a radio button drawn as a bordered card -->
        <Style x:Key="JenisLaporan" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1" Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Padding" Value="11"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The paper is always white with dark text, even in dark mode -->
        <DataTemplate DataType="{x:Type p:SelLaporan}">
            <Border x:Name="cell" BorderBrush="#E8E2CC" BorderThickness="0,0,0,1" Padding="4,6">
                <TextBlock x:Name="t" Text="{Binding Teks}" Foreground="#1F2A17" FontSize="12" TextWrapping="Wrap"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kanan}" Value="True">
                    <Setter TargetName="t" Property="TextAlignment" Value="Right"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Gaya}" Value="kepala">
                    <Setter TargetName="t" Property="Foreground" Value="#5C6650"/>
                    <Setter TargetName="t" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Gaya}" Value="kaki">
                    <Setter TargetName="t" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="cell" Property="BorderThickness" Value="0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="BarisPanel">
            <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Laporan" Style="{StaticResource T.H1}"/>
            <TextBlock Text="Pratinjau lalu simpan sebagai PDF atau Excel" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Options -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Jenis laporan" Style="{StaticResource T.Label}" Margin="0,0,0,8"/>
                    <RadioButton GroupName="jenisLap" Style="{StaticResource JenisLaporan}" IsChecked="{Binding Jenis, Converter={StaticResource Pilih}, ConverterParameter=ternak}">
                        <DockPanel>
                            <Border Style="{StaticResource IcoBox}" Width="34" Height="34" VerticalAlignment="Center"><c:Icon Kind="tag" Size="16" Thickness="2"/></Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Data ternak" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Jumlah ternak per kandang dan spesies" Style="{StaticResource T.Small}"/>
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton GroupName="jenisLap" Style="{StaticResource JenisLaporan}" IsChecked="{Binding Jenis, Converter={StaticResource Pilih}, ConverterParameter=kesehatan}">
                        <DockPanel>
                            <Border Style="{StaticResource IcoBox}" Width="34" Height="34" VerticalAlignment="Center"><c:Icon Kind="heart" Size="16" Thickness="2"/></Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Kesehatan" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Pemeriksaan dan pengobatan per periode" Style="{StaticResource T.Small}"/>
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton GroupName="jenisLap" Style="{StaticResource JenisLaporan}" IsChecked="{Binding Jenis, Converter={StaticResource Pilih}, ConverterParameter=keuangan}">
                        <DockPanel>
                            <Border Style="{StaticResource IcoBox}" Width="34" Height="34" VerticalAlignment="Center"><c:Icon Kind="wallet" Size="16" Thickness="2"/></Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Keuangan" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Laba-rugi per bulan" Style="{StaticResource T.Small}"/>
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton GroupName="jenisLap" Style="{StaticResource JenisLaporan}" IsChecked="{Binding Jenis, Converter={StaticResource Pilih}, ConverterParameter=pakan}">
                        <DockPanel>
                            <Border Style="{StaticResource IcoBox}" Width="34" Height="34" VerticalAlignment="Center"><c:Icon Kind="box" Size="16" Thickness="2"/></Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pakan" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Pakan masuk dan stok akhir" Style="{StaticResource T.Small}"/>
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>

                    <Grid Margin="0,8,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Dari" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding Dari}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sampai" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding Sampai}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Btn.Primary}" Click="SimpanPdf_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="file" Size="16"/>
                                <TextBlock Text="Simpan PDF" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource Btn.Secondary}" Command="{Binding EksporCommand}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="excel" Size="16"/>
                                <TextBlock Text="Ekspor Excel" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Preview -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24"
                    AutomationProperties.Name="Pratinjau laporan">
                <Border x:Name="paper" Background="White" CornerRadius="4" Padding="32,28" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Top" MinWidth="440">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.12"/>
                    </Border.Effect>
                    <StackPanel TextElement.Foreground="#1F2A17" TextElement.FontSize="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" TextElement.Foreground="#2E7A15">
                                <c:Icon Kind="leaf" Size="14" Thickness="2" Foreground="#2E7A15"/>
                                <TextBlock Text="TernakKu" FontWeight="Bold" Margin="6,0,0,0" Foreground="#2E7A15"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding JudulLaporan}" FontSize="16" FontWeight="Bold" Foreground="#1F2A17"/>
                                <TextBlock Foreground="#5C6650" Margin="0,2,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding NamaPeternakan, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PeriodeTeks, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Margin="0,14,0,0">
                            <ItemsControl ItemsSource="{Binding Kepala}" ItemsPanel="{StaticResource BarisPanel}"/>
                            <ItemsControl ItemsSource="{Binding Baris}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding}" ItemsPanel="{StaticResource BarisPanel}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Tidak ada data pada periode ini" Foreground="#5C6650" Margin="4,8,0,0" Visibility="{Binding Kosong, Converter={StaticResource BoolToVisible}}"/>
                            <ItemsControl ItemsSource="{Binding Kaki}" ItemsPanel="{StaticResource BarisPanel}"/>
                        </StackPanel>

                        <DockPanel Margin="0,14,0,0" TextElement.Foreground="#5C6650">
                            <TextBlock DockPanel.Dock="Right" Text="Halaman 1" Foreground="#5C6650"/>
                            <TextBlock Text="{Binding Dicetak}" Foreground="#5C6650"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
