<UserControl x:Class="TernakKu.App.Views.Pages.MasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TernakKu.App.Controls"
             xmlns:v="clr-namespace:TernakKu.App.Views.Pages"
             x:Name="page">
    <UserControl.Resources>
        <v:PilihanKonverter x:Key="Pilih"/>
        <Style x:Key="UbahBtn" TargetType="Button" BasedOn="{StaticResource Btn.GhostSm}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Visibility" Value="{Binding DataContext.BolehMaster, ElementName=page, Converter={StaticResource BoolToVisible}}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="edit" Size="14"/>
                            <TextBlock Text="Ubah" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Content" Value="x"/>
        </Style>
        <Style x:Key="TambahBtn" TargetType="Button" BasedOn="{StaticResource Btn.SecondarySm}">
            <Setter Property="Visibility" Value="{Binding DataContext.BolehMaster, ElementName=page, Converter={StaticResource BoolToVisible}}"/>
            <Setter Property="Content" Value="x"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="plus" Size="14" Thickness="2"/>
                            <TextBlock Text="Tambah" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StokRendah" TargetType="TextBlock" BasedOn="{StaticResource Cell.Right}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rendah}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Data master" Style="{StaticResource T.H1}"/>
            <TextBlock Text="Referensi yang dipakai di seluruh aplikasi" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="masterTab" Content="Spesies dan ras" Style="{StaticResource Tab}" IsChecked="{Binding Tab, Converter={StaticResource Pilih}, ConverterParameter=spesies}"/>
                <RadioButton GroupName="masterTab" Content="Kandang" Style="{StaticResource Tab}" IsChecked="{Binding Tab, Converter={StaticResource Pilih}, ConverterParameter=kandang}"/>
                <RadioButton GroupName="masterTab" Content="Pakan" Style="{StaticResource Tab}" IsChecked="{Binding Tab, Converter={StaticResource Pilih}, ConverterParameter=pakan}"/>
                <RadioButton GroupName="masterTab" Content="Obat dan vaksin" Style="{StaticResource Tab}" IsChecked="{Binding Tab, Converter={StaticResource Pilih}, ConverterParameter=obat}"/>
            </StackPanel>
        </Border>

        <!-- Spesies dan ras -->
        <Grid Visibility="{Binding TabSpesies, Converter={StaticResource BoolToVisible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardFlush}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="20,16,20,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource TambahBtn}" Command="{Binding TambahSpesiesCommand}"/>
                        <TextBlock Text="Spesies" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding Spesies}" MaxHeight="480">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*" ElementStyle="{StaticResource Cell.Strong}"/>
                            <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="70" ElementStyle="{StaticResource Cell.Muted}"/>
                            <DataGridTextColumn Header="Masa bunting" Binding="{Binding Bunting}" Width="Auto" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource Cell.Right}"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource UbahBtn}" Command="{Binding DataContext.UbahSpesiesCommand, ElementName=page}" CommandParameter="{Binding Id}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardFlush}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="20,16,20,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource TambahBtn}" Command="{Binding TambahRasCommand}"/>
                        <TextBlock Text="Ras" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding Ras}" MaxHeight="480">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ras" Binding="{Binding Nama}" Width="*" ElementStyle="{StaticResource Cell.Strong}"/>
                            <DataGridTextColumn Header="Spesies" Binding="{Binding Spesies}" Width="130" ElementStyle="{StaticResource Cell.Muted}"/>
                            <DataGridTextColumn Header="Jumlah aktif" Binding="{Binding Aktif}" Width="Auto" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource Cell.Right}"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource UbahBtn}" Command="{Binding DataContext.UbahRasCommand, ElementName=page}" CommandParameter="{Binding Id}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Kandang -->
        <Border Style="{StaticResource CardFlush}" Visibility="{Binding TabKandang, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <DockPanel Margin="20,16,20,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource TambahBtn}" Command="{Binding TambahKandangCommand}"/>
                    <TextBlock Text="Kandang" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding Kandang}" MaxHeight="480">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="90" ElementStyle="{StaticResource Cell.Strong}"/>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                        <DataGridTextColumn Header="Jenis" Binding="{Binding Jenis}" Width="140"/>
                        <DataGridTextColumn Header="Spesies" Binding="{Binding Spesies}" Width="140" ElementStyle="{StaticResource Cell.Muted}"/>
                        <DataGridTextColumn Header="Kapasitas" Binding="{Binding Kapasitas}" Width="110" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource Cell.Right}"/>
                        <DataGridTextColumn Header="Terisi" Binding="{Binding Terisi}" Width="100" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource Cell.Right}"/>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource UbahBtn}" Command="{Binding DataContext.UbahKandangCommand, ElementName=page}" CommandParameter="{Binding Id}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Pakan -->
        <Border Style="{StaticResource CardFlush}" Visibility="{Binding TabPakan, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <DockPanel Margin="20,16,20,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource TambahBtn}" Command="{Binding TambahPakanCommand}"/>
                    <TextBlock Text="Daftar pakan" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding Pakan}" MaxHeight="480">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*" ElementStyle="{StaticResource Cell.Strong}"/>
                        <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="100"/>
                        <DataGridTextColumn Header="Stok minimum" Binding="{Binding StokMinimum}" Width="140" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource Cell.Right}"/>
                        <DataGridTextColumn Header="Harga per satuan" Binding="{Binding Harga}" Width="170" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource Cell.Right}"/>
                        <DataGridTextColumn Header="Pemakaian / hari" Binding="{Binding Pemakaian}" Width="160" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource Cell.Right}"/>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource UbahBtn}" Command="{Binding DataContext.UbahPakanCommand, ElementName=page}" CommandParameter="{Binding Id}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Obat dan vaksin -->
        <Border Style="{StaticResource CardFlush}" Visibility="{Binding TabObat, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <DockPanel Margin="20,16,20,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource TambahBtn}" Command="{Binding TambahObatCommand}"/>
                    <TextBlock Text="Obat dan vaksin" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding Obat}" MaxHeight="480">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*" ElementStyle="{StaticResource Cell.Strong}"/>
                        <DataGridTemplateColumn Header="Jenis" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <c:Badge Text="{Binding Jenis}" Tone="{Binding JenisTone}" ShowDot="False" HorizontalAlignment="Left"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="110"/>
                        <DataGridTextColumn Header="Stok" Binding="{Binding Stok}" Width="110" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource StokRendah}"/>
                        <DataGridTextColumn Header="Minimum" Binding="{Binding StokMinimum}" Width="110" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource Cell.Right}"/>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource UbahBtn}" Command="{Binding DataContext.UbahObatCommand, ElementName=page}" CommandParameter="{Binding Id}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
