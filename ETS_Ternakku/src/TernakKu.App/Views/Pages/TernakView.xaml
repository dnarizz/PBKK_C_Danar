<UserControl x:Class="TernakKu.App.Views.Pages.TernakView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TernakKu.App.Controls"
             x:Name="page">
    <StackPanel>
        <!-- Header -->
        <Grid Margin="0,0,0,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Ternak" Style="{StaticResource T.H1}"/>
                <TextBlock Text="{Binding Subjudul}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Secondary}" Command="{Binding EksporCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="excel" Size="16"/>
                        <TextBlock Text="Ekspor Excel" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Primary}" Margin="10,0,0,0" Command="{Binding TambahCommand}"
                        Visibility="{Binding BolehTambah, Converter={StaticResource BoolToVisible}}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="plus" Size="16" Thickness="2.25"/>
                        <TextBlock Text="Tambah ternak" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource CardFlush}">
            <StackPanel>
                <!-- Toolbar -->
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Width="280" Height="36" c:Ui.Icon="search" c:Ui.Placeholder="Cari kode, nama, atau ras" AutomationProperties.Name="Cari ternak"
                             Text="{Binding Cari, UpdateSourceTrigger=PropertyChanged}"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Chips}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource Chip}" Margin="0,0,8,0" IsChecked="{Binding Aktif, Mode=OneWay}"
                                              Command="{Binding DataContext.PilihSpesiesCommand, ElementName=page}" CommandParameter="{Binding Id}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}"/>
                                        <TextBlock Text="{Binding Jumlah}" FontSize="11" Opacity="0.75" Margin="6,1,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ComboBox Grid.Column="3" Width="190" Height="36" ItemsSource="{Binding OpsiKandang}" DisplayMemberPath="Teks" SelectedValuePath="Nilai"
                              SelectedValue="{Binding KandangId}" AutomationProperties.Name="Kandang"/>
                    <ComboBox Grid.Column="4" Width="140" Height="36" Margin="8,0,0,0" ItemsSource="{Binding OpsiStatus}" DisplayMemberPath="Teks" SelectedValuePath="Nilai"
                              SelectedValue="{Binding Status}" AutomationProperties.Name="Status"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                <!-- Table -->
                <DataGrid x:Name="grid" Style="{StaticResource Grid}" ItemsSource="{Binding Daftar}" PreviewMouseWheel="Grid_PreviewMouseWheel"
                          VerticalScrollBarVisibility="Disabled" Visibility="{Binding Daftar, Converter={StaticResource EmptyToCollapsed}}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
                            <Setter Property="Cursor" Value="Hand"/>
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Row_Click"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Kode" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Kode}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Nama · ras" Width="*" MinWidth="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Nama, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · " Foreground="{DynamicResource Text2Brush}"/><Run Text="{Binding Ras, Mode=OneWay}" Foreground="{DynamicResource Text2Brush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Spesies" Binding="{Binding Spesies}" Width="80"/>
                        <DataGridTextColumn Header="Kelamin" Binding="{Binding Kelamin}" Width="80"/>
                        <DataGridTextColumn Header="Umur" Binding="{Binding Umur}" Width="90"/>
                        <DataGridTextColumn Header="Kandang" Binding="{Binding Kandang}" Width="170" ElementStyle="{StaticResource Cell.Muted}"/>
                        <DataGridTextColumn Header="Berat terakhir" Binding="{Binding Berat}" Width="120" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource Cell.StrongRight}"/>
                        <DataGridTemplateColumn Header="Kondisi" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <c:Badge Text="{Binding Kondisi}" Tone="{Binding Tone}" HorizontalAlignment="Left"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Btn.GhostSm}" HorizontalAlignment="Right" IsHitTestVisible="False" Focusable="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Detail"/>
                                            <c:Icon Kind="chevR" Size="14" Thickness="2" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" Margin="0,48" Visibility="{Binding Daftar, Converter={StaticResource EmptyToVisible}}">
                    <TextBlock Text="Tidak ada ternak yang cocok" Style="{StaticResource T.Strong}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Coba kata kunci lain atau pilih spesies Semua." Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Pager -->
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.GhostSm}" Width="30" Padding="0" Command="{Binding PrevCommand}" ToolTip="Sebelumnya"><c:Icon Kind="chevL" Size="14" Thickness="2"/></Button>
                            <ItemsControl ItemsSource="{Binding TombolHalaman}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Teks}" MinWidth="30" Margin="4,0,0,0" Padding="6,0" IsEnabled="{Binding BisaDiklik}"
                                                Command="{Binding DataContext.KePageCommand, ElementName=page}" CommandParameter="{Binding No}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Btn.GhostSm}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Aktif}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource Btn.GhostSm}" Width="30" Padding="0" Margin="4,0,0,0" Command="{Binding NextCommand}" ToolTip="Berikutnya"><c:Icon Kind="chevR" Size="14" Thickness="2"/></Button>
                        </StackPanel>
                        <TextBlock Text="{Binding Ringkas}" Style="{StaticResource T.Small}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
