<UserControl x:Class="TernakKu.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TernakKu.App.Controls"
             x:Name="shell">
    <UserControl.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsActive}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SidebarBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ===== Main area with background scenery ===== -->
        <Grid Grid.Column="1" ClipToBounds="True">
            <Grid IsHitTestVisible="False">
                <Ellipse Width="480" Height="480" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-120,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource DecoSunColor}" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path Width="420" Height="160" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,72,0,0" Opacity="0.07"
                      Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                      Data="M-10 40C80 10 170 70 260 40s120 -30 170 -10 M-10 80c90 -30 180 30 270 0s120 -30 170 -10 M-10 120c90 -30 180 30 270 0s120 -30 170 -10 M-10 160c90 -30 180 30 270 0s120 -30 170 -10"/>
                <Path Height="170" Stretch="Fill" VerticalAlignment="Bottom" Fill="{DynamicResource DecoHillBrush}" Opacity="0.09"
                      Data="M0 120C180 70 360 60 560 95s380 55 560 15s250 -40 320 -30V200H0Z"/>
                <Path Height="110" Stretch="Fill" VerticalAlignment="Bottom" Fill="{DynamicResource DecoHillBrush}" Opacity="0.16"
                      Data="M0 160c200 -40 420 -50 640 -20s420 40 600 5s160 -25 200 -20V200H0Z"/>
                <c:LineArt Width="260" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,34" Opacity="0.2"
                           Stroke="{DynamicResource PrimaryBrush}" Data="{Binding Adegan, Converter={StaticResource SceneGeometry}}"/>
                <Path Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="36,0,0,26" Opacity="0.22"
                      Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M30 56V20 M30 34c-8 -2 -13 -8 -13 -16c8 1 13 7 13 16Z M30 26c7 -2 11 -7 11 -14c-7 1 -11 6 -11 14Z"/>
            </Grid>

            <ScrollViewer x:Name="pageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ContentControl x:Name="page" Content="{Binding Halaman}" Margin="24,24,32,40" MaxWidth="1480" HorizontalAlignment="Stretch" Focusable="False">
                    <ContentControl.RenderTransform><TranslateTransform x:Name="pageShift"/></ContentControl.RenderTransform>
                </ContentControl>
            </ScrollViewer>
        </Grid>

        <!-- ===== Floating nav bar ===== -->
        <Grid x:Name="navHost" Margin="12,12,0,12" Panel.ZIndex="2">
            <Border x:Name="sidebar" Width="252" CornerRadius="16" Background="{DynamicResource SidebarBrush}" Effect="{StaticResource Shadow.Soft}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Farm card -->
                    <Border x:Name="farmCard" Margin="12,12,12,6" Padding="10" CornerRadius="12" Background="{DynamicResource SidebarCardBrush}"
                            ToolTipService.IsEnabled="{Binding Ciut}" ToolTipService.Placement="Right">
                        <Border.ToolTip>
                            <TextBlock><Run Text="{Binding NamaPeternakan, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding NamaFile, Mode=OneWay}"/></TextBlock>
                        </Border.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource LeafBrush}">
                                <c:Icon Kind="leaf" Size="22" Thickness="2" Foreground="{DynamicResource LeafInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel x:Name="farmMeta" Margin="10,0,0,0" VerticalAlignment="Center" Width="160">
                                <TextBlock Text="{Binding NamaPeternakan}" Foreground="{DynamicResource SidebarTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource LeafBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTamu}" Value="True">
                                                        <Setter Property="Fill" Value="#F0B45A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding NamaFile}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nav items with the sliding active pill behind them -->
                    <ScrollViewer x:Name="navScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Grid x:Name="navArea" Margin="12,0,12,8">
                            <Border x:Name="navInd" VerticalAlignment="Top" Height="40" CornerRadius="10" Background="{DynamicResource SidebarTextBrush}" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform><TranslateTransform x:Name="navIndShift"/></Border.RenderTransform>
                            </Border>
                            <ItemsControl x:Name="navList" ItemsSource="{Binding Nav}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- Group label (expanded) or divider (collapsed) -->
                                            <Grid Visibility="{Binding IsFirstInGroup, Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Text="{Binding Group}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,10,0,3"
                                                           Visibility="{Binding DataContext.Ciut, ElementName=shell, Converter={StaticResource BoolToCollapsed}}"/>
                                                <Border Height="1" Margin="6,10" Background="{DynamicResource SidebarHoverBrush}"
                                                        Visibility="{Binding DataContext.Ciut, ElementName=shell, Converter={StaticResource BoolToVisible}}"/>
                                            </Grid>
                                            <Button x:Name="navBtn" Style="{StaticResource NavButton}"
                                                    Command="{Binding DataContext.BukaCommand, ElementName=shell}" CommandParameter="{Binding Key}"
                                                    ToolTip="{Binding Tip}" ToolTipService.IsEnabled="{Binding DataContext.Ciut, ElementName=shell}" ToolTipService.Placement="Right"
                                                    AutomationProperties.Name="{Binding Tip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="20" Height="20">
                                                        <c:Icon Kind="{Binding Icon}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Ellipse x:Name="dot" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-5,0"
                                                                 StrokeThickness="2" Stroke="{DynamicResource SidebarBrush}" Visibility="Collapsed" Fill="#F0B45A"/>
                                                    </Grid>
                                                    <TextBlock x:Name="lbl" Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                    <Border x:Name="count" Grid.Column="2" CornerRadius="9" Padding="8,1" Background="#FCE3C1" Visibility="Collapsed" VerticalAlignment="Center">
                                                        <TextBlock x:Name="countText" Text="{Binding Count}" FontSize="11" FontWeight="Bold" Foreground="#6B3A06"/>
                                                    </Border>
                                                    <c:Icon x:Name="leaf" Grid.Column="2" Kind="leaf" Size="14" Thickness="2" Foreground="{DynamicResource PrimaryBrush}" Visibility="Collapsed" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Tone}" Value="warn">
                                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="count" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="danger">
                                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="dot" Property="Fill" Value="#F07A6C"/>
                                                <Setter TargetName="count" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="count" Property="Background" Value="#FDE8E4"/>
                                                <Setter TargetName="countText" Property="Foreground" Value="#B42318"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsActive}" Value="True"/>
                                                    <Condition Binding="{Binding Count}" Value="0"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="leaf" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="dot" Property="Stroke" Value="{DynamicResource SidebarTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.Ciut, ElementName=shell}" Value="True">
                                                <Setter TargetName="lbl" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="count" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="leaf" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="navBtn" Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter TargetName="navBtn" Property="Padding" Value="0"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- Small farm scene (different from the background one) -->
                    <StackPanel x:Name="sidebarArt" Grid.Row="2" Margin="16,4,16,0" Opacity="0.3">
                        <c:LineArt Stroke="{DynamicResource SidebarTextBrush}" Data="{Binding AdeganSidebar, Converter={StaticResource SceneGeometry}}"/>
                        <Path Height="10" Stretch="Fill" Stroke="{DynamicResource SidebarTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M0 4c60 -6 140 -6 260 0 M0 12c50 -4 120 -4 180 -1s60 2 80 -1"/>
                    </StackPanel>

                    <!-- User card -->
                    <Border x:Name="foot" Grid.Row="3" Margin="12,8,12,12" Padding="8" CornerRadius="12" Background="{DynamicResource SidebarFootBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource SidebarTextBrush}"
                                    ToolTipService.IsEnabled="{Binding Ciut}" ToolTipService.Placement="Right">
                                <Border.ToolTip>
                                    <TextBlock><Run Text="{Binding NamaUser, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding LabelPeran, Mode=OneWay}"/></TextBlock>
                                </Border.ToolTip>
                                <Grid>
                                    <TextBlock Text="{Binding Inisial}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SidebarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsTamu, Converter={StaticResource BoolToCollapsed}}"/>
                                    <c:Icon Kind="guest" Size="18" Foreground="{DynamicResource SidebarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsTamu, Converter={StaticResource BoolToVisible}}"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="who" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NamaUser}" Foreground="{DynamicResource SidebarTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding LabelPeran}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="12"/>
                            </StackPanel>
                            <Button x:Name="logout" Grid.Column="2" Command="{Binding KeluarCommand}" Width="36" Height="36" Padding="0"
                                    Style="{StaticResource Btn.IconGhost}" Foreground="{DynamicResource SidebarTextBrush}" ToolTip="Keluar">
                                <c:Icon Kind="logout" Size="18"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Collapse handle on the bar's edge -->
            <Button x:Name="collapseBtn" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,-12,0" Width="24" Height="24"
                    Command="{Binding ToggleNavCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Ciutkan atau lebarkan menu">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.18"/></Border.Effect>
                            <c:Icon x:Name="chev" Kind="chevL" Size="14" Thickness="2.25" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Ciut}" Value="True">
                                <Setter TargetName="chev" Property="Kind" Value="chevR"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ===== Dialog overlay ===== -->
        <Grid x:Name="dialogLayer" Grid.ColumnSpan="2" Panel.ZIndex="10" Visibility="{Binding Dialog, Converter={StaticResource EmptyToCollapsed}}">
            <Rectangle Fill="{DynamicResource ScrimBrush}" MouseLeftButtonDown="Scrim_MouseDown"/>
            <Border x:Name="dialogCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxHeight="{Binding ActualHeight, ElementName=dialogLayer}"
                    Effect="{StaticResource Shadow.Pop}" RenderTransformOrigin="0.5,0.5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="540"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Dialog.Lebar}" Value="True">
                                <Setter Property="Width" Value="700"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.RenderTransform><ScaleTransform x:Name="dialogScale"/></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="20,18,14,0">
                        <TextBlock Text="{Binding Dialog.Judul}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Command="{Binding Dialog.BatalCommand}" Style="{StaticResource Btn.IconGhost}" ToolTip="Tutup (Esc)">
                            <c:Icon Kind="x" Size="18"/>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <ContentControl x:Name="dialogBody" Content="{Binding Dialog}" Margin="20,12,20,18" Focusable="False">
                            <ContentControl.ContentTemplateSelector><c:ViewLocator/></ContentControl.ContentTemplateSelector>
                        </ContentControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="20,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Batal" Command="{Binding Dialog.BatalCommand}" Style="{StaticResource Btn.Secondary}" IsCancel="True" Margin="0,0,10,0"/>
                            <Button Content="{Binding Dialog.TombolOk}" Command="{Binding Dialog.OkCommand}" IsDefault="True">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dialog.Bahaya}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Snackbar ===== -->
        <Border x:Name="snack" Grid.ColumnSpan="2" Panel.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Background="{DynamicResource SnackBgBrush}" CornerRadius="8" Padding="16,8,8,8" Effect="{StaticResource Shadow.Pop}"
                Visibility="{Binding Snack, Converter={StaticResource EmptyToCollapsed}}">
            <Border.RenderTransform><TranslateTransform x:Name="snackShift"/></Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <c:Icon Kind="check" Size="16" Thickness="2.25" Foreground="{DynamicResource SnackTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Snack.Teks}" Foreground="{DynamicResource SnackTextBrush}" Margin="10,0,16,0" VerticalAlignment="Center"/>
                <Button Content="Batalkan" Command="{Binding UndoCommand}" Height="32" Padding="10,0" Foreground="{DynamicResource LeafBrush}" Background="Transparent"
                        Style="{StaticResource Btn.Ghost}" Visibility="{Binding Snack.BisaUndo, Converter={StaticResource BoolToVisible}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
